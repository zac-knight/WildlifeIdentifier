# Copy to .env (ml) or web/.env.local (web). Dummy values only: never commit real keys.
# The app runs without every value below. Each feature degrades gracefully when its key is missing.

# Postgres for feedback and cached species cards (Neon free tier)
DATABASE_URL=postgres://user:password@localhost:5432/wildlens

# Optional LLM for species cards. Without it, cards show the retrieved facts directly.
GOOGLE_GENERATIVE_AI_API_KEY=dummy-key

# Secret used to hash anonymous session identifiers
SESSION_HASH_SECRET=dummy-secret

# Hugging Face repository that hosts the public model files
NEXT_PUBLIC_MODEL_BASE_URL=https://huggingface.co/zac-knight/wildlens-models/resolve/main

# Contact shown in the User-Agent of outbound data requests
WILDLENS_CONTACT=github.com/zac-knight/WildlifeIdentifier

# Optional overrides for ML scripts
WILDLENS_DATA_DIR=../data
WILDLENS_MODELS_DIR=../models
